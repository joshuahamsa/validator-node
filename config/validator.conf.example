# XRPL Validator Node — configuration
# Copy to config/validator.conf and fill in your values, OR run motd/setup.sh.
# After editing, run: sudo cp config/validator.conf /etc/validator-node/validator.conf

# Linux username that runs the metrics-server service
VALIDATOR_USERNAME=

# Absolute path to your home directory
VALIDATOR_HOME=

# Directory containing your validator key JSON file (*.json)
# Typically ~/.ripple or a custom path
VALIDATOR_JSON_DIR=

# Your validator domain — shown in the MOTD subtitle and identity section
VALIDATOR_DOMAIN=

# Tailscale Funnel URL for the web dashboard (validator.html)
# Example: https://myhostname.tail12345.ts.net
# Leave empty if not using Tailscale Funnel; patch later by re-running setup.sh
METRICS_URL=

# Absolute path to this cloned repository
REPO_PATH=

# Optional: path to xrpld Feature.cpp source for vote-default parsing
# Only needed if you compile xrpld from source; leave empty otherwise
XRPL_FEATURES_SRC=

# ── xrpld node binding ────────────────────────────────────────────────────────
# xrpld is the renamed rippled package (3.2.0+). If you are still on the legacy
# rippled package, set these to /usr/local/bin/rippled, rippled, and
# /etc/opt/ripple/rippled.cfg respectively.

# Path to the xrpld binary (used for server_info / feature queries)
XRPLD_BIN=/usr/bin/xrpld

# systemd unit name (used for journalctl alerts and service ordering)
XRPLD_UNIT=xrpld

# Path to your xrpld.cfg — used to parse [veto_amendments] and [amendments]
XRPLD_CFG=/etc/xrpld/xrpld.cfg

# Admin RPC endpoint — required for the `feature` call to expose vetoed state
XRPLD_ADMIN_RPC=127.0.0.1:5006
